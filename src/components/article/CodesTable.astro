---
/**
 * Structured codes table (v1.8) — driven by the `codes` frontmatter array.
 *
 * Splits by `status` into two sections:
 *   - Active: CodeBlock list (one-click copy — the highest-retention UI on
 *     a codes page), label = reward + expiry freshness signal.
 *   - Expired: plain table. Deliberately kept (not deleted) — expired-code
 *     queries ("is FORGE-2026 still working") are long-tail SEO traffic.
 *
 * Renders nothing when the array is empty.
 */
import { Icon } from 'astro-icon/components';
import CodeBlock from './CodeBlock.astro';

interface CodeItem {
  code: string;
  reward?: string;
  status: 'active' | 'expired';
  expiryDate?: string;
  source?: string;
}

interface Props {
  codes: CodeItem[];
  /** Locale strings from shared.codesTable (active/expired/reward/expires/code). */
  labels: Record<string, string>;
  /** "Copied!" feedback text passed through to CodeBlock. */
  copiedText?: string;
}

const { codes, labels, copiedText } = Astro.props;
if (codes.length === 0) return null;

const t = (key: string, fallback: string) => labels[key] ?? fallback;

const active = codes.filter((c) => c.status === 'active');
const expired = codes.filter((c) => c.status === 'expired');

const codeLabel = (c: CodeItem) =>
  [
    c.reward,
    c.expiryDate ? `${t("expires","Expires")}: ${c.expiryDate}` : undefined,
    c.source ? `${t("source","Source")}: ${c.source}` : undefined,
  ]
    .filter(Boolean)
    .join(' · ');
---

<div class="not-prose mt-6 space-y-8">
  {
    active.length > 0 && (
      <section aria-label={t("active","Active Codes")}>
        <h2 class="flex items-center gap-2 text-lg font-bold">
          <Icon name="lucide:circle-check" class="h-5 w-5 text-nav" />
          {t("active","Active Codes")}
          <span class="rounded-full bg-nav/10 px-2 py-0.5 text-xs font-semibold text-foreground">
            {active.length}
          </span>
        </h2>
        <div class="mt-3 space-y-2">
          {active.map((c) => (
            <CodeBlock code={c.code} label={codeLabel(c) || undefined} copiedText={copiedText} />
          ))}
        </div>
      </section>
    )
  }

  {
    expired.length > 0 && (
      <section aria-label={t("expired","Expired Codes")}>
        <h2 class="flex items-center gap-2 text-lg font-bold text-muted-foreground">
          <Icon name="lucide:circle-x" class="h-5 w-5" />
          {t("expired","Expired Codes")}
        </h2>
        <div class="mt-3 overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50 text-left text-xs text-foreground">
                <th class="px-3 py-2 font-medium">{t("code", "Code")}</th>
                <th class="px-3 py-2 font-medium">{t("reward","Reward")}</th>
                <th class="px-3 py-2 font-medium">{t("expires","Expires")}</th>
                <th class="px-3 py-2 font-medium">{t("source","Source")}</th>
              </tr>
            </thead>
            <tbody>
              {expired.map((c) => (
                <tr class="border-b border-border/60 last:border-0">
                  <td class="px-3 py-2 font-mono text-xs text-muted-foreground line-through">
                    {c.code}
                  </td>
                  <td class="px-3 py-2 text-muted-foreground">{c.reward ?? '—'}</td>
                  <td class="px-3 py-2 text-muted-foreground">{c.expiryDate ?? '—'}</td>
                  <td class="px-3 py-2 text-muted-foreground">{c.source ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</div>
