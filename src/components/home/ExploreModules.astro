---
/**
 * ExploreModules — renders the homepage content modules.
 *
 * Each module specifies a `displayType` that controls how its `highlights`
 * are rendered. We dispatch to the corresponding sub-component.
 *
 * Supported displayTypes (per PRD §6.5):
 *   - badge-list      → CodeCards (codes status: count + check date, no codes)
 *   - steps    → StepByStep (numbered progression steps)
 *   - ranked-grid       → TierGrid (S/A/B/C ranked items)
 *   - labeled-cards       → CardList (simple labeled cards)
 *   - timeline        → Timeline (vertical timeline of dated events)
 *   - video-grid      → VideoGrid (2-column video thumbnail grid)
 *
 * v0.2: each module card is now a single clickable <a> (block-level) with
 * hover border feedback, replacing the cramped "View" link that sat on the
 * same line as the title. The whole tile navigates; an arrow in the footer
 * signals affordance.
 *
 * badge-list modules show a codes STATUS — how many codes work and when the
 * codes page last checked them — never the codes themselves. Listing them
 * made the homepage a second, stronger codes page: 2026-10 dropafruit and
 * animemysterious had 98% of "<game> codes" impressions on the homepage at
 * #8–10 with ~0 clicks, the codes page ~0. Every codes-query winner (Fandom
 * /wiki/Codes, IGN wikis, wiki.vanguards.gg, our holefishing at #2) keeps the
 * list on the codes page and only links it from the homepage. The count and
 * date come from the codes page's `codes:` / `lastModified` frontmatter (the
 * locale JSON copy never follows the page — commandanarmy 2026-10-13);
 * `highlights.length` is the fallback when the href is not a codes page.
 */
import { Icon } from 'astro-icon/components';
import CodeCards from './modules/CodeCards.astro';
import StepByStep from './modules/StepByStep.astro';
import TierGrid from './modules/TierGrid.astro';
import CardList from './modules/CardList.astro';
import Timeline from './modules/Timeline.astro';
import VideoGrid from './modules/VideoGrid.astro';
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';
import { getUi } from '~/i18n/ui';
import { getEntryWithFallback, resolveHubHref } from '~/i18n/content';

interface Props {
  modules: Array<{
    order: number;
    name: string;
    description: string;
    href: string;
    displayType: string;
    // highlights 的字段结构由 displayType 决定(见各子组件 Props),
    // dispatcher 不假设具体字段。类型安全由各子组件内部的 Props
    // interface 保证(JSON 层不参与 TS 检查,见 spec §2.2)。
    highlights: Array<any>;
  }>;
  locale: Locale;
}
const { modules, locale } = Astro.props;
const sharedStrings = getUi(locale).shared;
const viewAll = sharedStrings.viewAll ?? 'View all';

async function codesStatus(href: string, fallbackCount: number) {
  const [category, slug] = href.replace(/^\/+|\/+$/g, '').split('/');
  const data = category && slug ? (await getEntryWithFallback(category, slug, locale))?.entry.data : undefined;
  if (!data) return { active: fallbackCount, checked: undefined };
  // Pages that keep codes in a body table (no `codes:` frontmatter) still give the check date.
  const active = data.codes ? data.codes.filter((c) => c.status === 'active').length : fallbackCount;
  return { active, checked: data.lastModified ?? data.date };
}
// A hand-written "/codes" href resolves to the article when that hub is folded (lib/hub-redirects.ts).
const resolved = await Promise.all(
  modules.map(async (m) => {
    const href = await resolveHubHref(m.href, locale);
    return { ...m, href, status: m.displayType === 'badge-list' ? await codesStatus(href, m.highlights.length) : undefined };
  }),
);
---

<div class="grid gap-6 md:grid-cols-2">
  {
    resolved.map((m) => (
      <a href={localizePath(m.href, locale)} class="card group block overflow-hidden p-5">
        <h3 class="text-lg font-bold leading-snug">{m.name}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{m.description}</p>

        <div class="mt-4">
          {m.status && <CodeCards active={m.status.active} checked={m.status.checked} locale={locale} />}
          {m.displayType === 'steps' && <StepByStep highlights={m.highlights} />}
          {m.displayType === 'ranked-grid' && <TierGrid highlights={m.highlights} />}
          {m.displayType === 'labeled-cards' && <CardList highlights={m.highlights} />}
          {m.displayType === 'timeline' && <Timeline highlights={m.highlights} />}
          {m.displayType === 'video-grid' && <VideoGrid highlights={m.highlights} />}
        </div>

        <p class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-foreground hover:text-nav">
          <span class="border-b border-transparent transition group-hover:border-nav">{viewAll}</span>
          <Icon
            name="lucide:arrow-right"
            class="h-3 w-3 transition group-hover:translate-x-0.5"
          />
        </p>
      </a>
    ))
  }
</div>
