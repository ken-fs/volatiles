---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs, theme decoration / official art
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   2b. Page index   — every article of each section (≥2 entries) as a link chip
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta      — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { categoryHref, getEntriesByCategory, getRecentEntries, parseEntryId, resolveHubHref } from '~/lib/content';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
// Typed straight from en.json (HomeUi) — no `as any`: a renamed key now
// fails typecheck instead of silently blanking the block (check-i18n only
// compares locale↔en, not component↔en; tests/home-ui.test.ts pins the
// access surface at the JSON level too).
const home = ui.home;
const shared = ui.shared;

const recent = await getRecentEntries(locale, 6);

// Page index: one direct homepage link to every article. 2026-10-21
// animemysterious: the homepage linked 0 of 33 unit pages and Google left
// most of them "URL is unknown" for 9 days while thin tag pages ranked in
// their place. Chip label = title before " — " ("Gilgamesh — Anime
// Mysterious Unit Guide" → "Gilgamesh"), minus a leading game name ("Anime
// Mysterious Battle Pass" → "Battle Pass"). Single-entry sections are
// already reachable from Quick Start / nav.
const gamePrefix = `${site.game.name.toLowerCase()} `;
const shortTitle = (t: string) => {
  const head = t.split(/\s+[—–|]\s+|:\s+/)[0]!.trim();
  const rest = head.toLowerCase().startsWith(gamePrefix) ? head.slice(gamePrefix.length).trim() : '';
  return rest || head;
};
const pageIndex = (
  await Promise.all(
    NAVIGATION_CONFIG.map(async (item) => ({
      key: item.key,
      label: ui.nav[item.key as keyof typeof ui.nav] ?? item.key,
      entries: (await getEntriesByCategory(item.key, locale))
        .map((entry) => ({ entry, parsed: parseEntryId(entry.id) }))
        .filter((x) => x.parsed)
        .map(({ entry, parsed }) => ({ href: detailPath(parsed!.category, parsed!.slug, locale), label: shortTitle(entry.data.title) }))
        .sort((a, b) => a.label.localeCompare(b.label, locale)),
    })),
  )
).filter((s) => s.entries.length >= 2);
// Second nav category (guides). Single-article categories link the article — lib/hub-redirects.ts.
const guidesHref = await categoryHref(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale);

// Per-field fallbacks: a locale JSON whose meta object exists but lacks
// title/description must not pass undefined into BaseLayout (title.includes
// crashes the build) — same spirit as the ?? defaults below.
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
// Section namespaces come from en.json verbatim (getUi deep-merges non-en
// locales over en), so every key is guaranteed present — no per-section
// `{ cards: [] }`-style fallbacks and no hardcoded English anywhere. A key
// missing from en.json itself is a build-time typecheck failure, not a
// blanked section at runtime.
const hero: HomeUi['hero'] = home.hero;
const updates: HomeUi['updates'] = home.updates;
const start: HomeUi['start'] = home.start;
const popular: HomeUi['popular'] = home.popular;
const explore: HomeUi['explore'] = home.explore;
const closingCta: HomeUi['closingCta'] = home.closingCta;

// Optional official art (src/assets/brand/cover-bg.{png,jpg,webp}) — the same
// file gen-covers uses as the cover backdrop. Absent in the bare template.
const brandArt = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brand/cover-bg.{png,jpg,jpeg,webp}', {
  eager: true,
});
const heroShot = Object.values(brandArt)[0]?.default;

// Accent the last word of the hero title ("Example Game <Wiki>").
const titleWords = hero.title.trim().split(/\s+/);
const heroTitleTail = titleWords.length > 1 ? titleWords.pop() : '';
const heroTitleHead = titleWords.join(' ') + (heroTitleTail ? ' ' : '');

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
// A hand-written "/codes" href resolves to the article when that hub is folded (lib/hub-redirects.ts).
const trendingHrefs = await Promise.all(
  trendingLinks.map(async (link) => (typeof link === 'string' ? null : localizePath(await resolveHubHref(link.href, locale), locale))),
);
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ───────────────────────────────
      Styled by the game theme: `.tag` badge, theme display font on <h1>,
      `.btn-ember` primary CTA and `.hero-glow` decoration (3 <span>s — every
      theme draws them differently). With official art in
      src/assets/brand/cover-bg.png the right column shows it (drilltoearthscore
      2026-09-21: a real screenshot is the strongest first-screen trust signal);
      without it the decoration carries the first screen on its own. */}
  <section class="relative isolate overflow-hidden border-b border-border">
    <div class="hero-glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <div
      class:list={[
        'relative mx-auto grid w-full max-w-7xl gap-10 px-4 py-16 md:py-24',
        heroShot && 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center lg:gap-14',
      ]}
    >
      <div>
        <p class="tag">{hero.badge}</p>
        <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
          {heroTitleHead}
          {heroTitleTail && <span class="text-nav">{heroTitleTail}</span>}
        </h1>
        <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            hero.ctaPrimary && (
              <a href={site.social.official} target="_blank" rel="noopener noreferrer" class="btn-ember">
                <Icon name="lucide:play" class="h-4 w-4" />
                {hero.ctaPrimary}
              </a>
            )
          }
          {
            hero.ctaSecondary && (
              <a href={guidesHref} class="btn-outline">
                {hero.ctaSecondary}
              </a>
            )
          }
        </div>
      </div>
      {
        heroShot && (
          /* Eager + high priority: on mobile this is the LCP element. */
          <div class="tile overflow-hidden p-1.5">
            <Image
              src={heroShot}
              alt={`${site.game.name} gameplay screenshot`}
              widths={[400, Math.min(heroShot.width, 768)]}
              sizes="(max-width: 1023px) 100vw, 620px"
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full rounded-[inherit]"
            />
          </div>
        )
      }
    </div>
  </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && (
    <VideoSection videoId={hero.videoId} title={`${site.game.name} ${shared.gameTrailer}`} />
  )}

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ───────────────────────────── Page index ─────────────────────────── */}
  {
    pageIndex.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl">{home.index.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{home.index.description}</p>
        <div class="mt-6 space-y-8">
          {pageIndex.map((sec) => (
            <div>
              <div class="flex items-baseline justify-between">
                <h3 class="text-lg font-bold">
                  {sec.label} <span class="text-sm font-normal text-muted-foreground">({sec.entries.length})</span>
                </h3>
                <a href={listPath(sec.key, locale)} class="arrow-link text-sm font-semibold text-nav">
                  {shared.browseAll} <span class="arrow">→</span>
                </a>
              </div>
              <ul class="mt-3 flex flex-wrap gap-2">
                {sec.entries.map((x) => (
                  <li>
                    <a href={x.href} class="card inline-block px-3 py-1.5 text-sm font-medium">
                      {x.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl">{updates.title}</h2>
          <a href={guidesHref} class="arrow-link text-sm font-semibold text-nav"
            >{shared.browseAll} <span class="arrow">→</span></a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs text-muted-foreground">
                      {parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {trendingLinks.length > 0 && (
        <aside>
          <p class="tag">{popular.badge}</p>
          <h2 class="mt-3 text-2xl">{popular.title}</h2>
          <ul class="mt-4 space-y-2">
            {trendingLinks.map((link: QuickLink, i: number) => {
              const href = trendingHrefs[i];
              const label = trendingLabel(link);
              return (
                <li>
                  {href ? (
                    <a href={href} class="card flex items-center gap-2 p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </a>
                  ) : (
                    <div class="tile flex items-center gap-2 p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ───────────────── Adsterra 300×250 (mid-page) ─────────────────── */}
  {/* Validated on volatiles + devour (2026-10-11). Slot file: public/ads/homepage-300x250.html,
      gated on PUBLIC_ADSTERRA_SLOT_HOMEPAGE_300X250 — empty env = nothing rendered. */}
  <div class="mx-auto flex justify-center px-4 py-8">
    <AdsterraSlot name="homepage-300x250" width={300} height={250} />
  </div>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="tile p-8 md:p-12">
          <h2 class="text-2xl md:text-3xl">{closingCta.title}</h2>
          <p class="mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ember"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
