---
/**
 * Tier-grid displayType — S/A/B/C ranked items.
 * Used for tier lists on the homepage.
 */
interface Props {
  highlights: Array<{ label: string; detail: string }>;
}
const { highlights } = Astro.props;

const tierColors: Record<string, string> = {
  S: 'bg-rust text-primary-foreground',
  A: 'bg-ochre/40 text-ink',
  B: 'bg-moss/35 text-ink',
  C: 'bg-muted text-muted-foreground',
};
---

<div class="space-y-2">
  {
    highlights.map((h) => (
      <div class="flex items-center gap-3 rounded-md border bg-card p-3">
        <span
          class:list={[
            'flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-sm font-bold',
            tierColors[h.label] ?? 'bg-muted text-muted-foreground',
          ]}
        >
          {h.label}
        </span>
        <p class="text-sm text-muted-foreground">{h.detail}</p>
      </div>
    ))
  }
</div>
