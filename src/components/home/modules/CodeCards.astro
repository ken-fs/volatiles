---
/**
 * Code-cards displayType — the homepage "Codes" module.
 *
 * Shows how many codes work and when they were last checked, NOT the codes:
 * the list lives on the codes page only, so the homepage stops competing with
 * it for "<game> codes" (see ExploreModules docblock). The surrounding card
 * links the codes page.
 */
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';

interface Props {
  active: number;
  checked?: Date;
  locale: Locale;
}
const { active, checked, locale } = Astro.props;
const shared = getUi(locale).shared;
const countLabel = active > 0 ? shared.codesActive.replace('{count}', String(active)) : shared.codesNone;
const checkedLabel = checked
  ? shared.codesChecked.replace('{date}', checked.toLocaleDateString(locale, { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' }))
  : '';
---

<div class="flex items-center justify-between rounded-md border bg-card p-3">
  <p class="text-sm font-semibold text-foreground">{countLabel}</p>
  {checkedLabel && <p class="ml-2 shrink-0 text-xs text-muted-foreground">{checkedLabel}</p>}
</div>
