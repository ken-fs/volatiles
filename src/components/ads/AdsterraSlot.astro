---
/**
 * AdsterraSlot — an Adsterra ad unit mounted in its own sandboxed iframe.
 *
 * Adsterra banner scripts all configure themselves through the shared
 * `window.atOptions` global, so two units inlined on one page clobber each
 * other (slot B renders with slot A's config). Every unit therefore keeps
 * exactly the snippet from the Adsterra dashboard (Ad Units → GET CODE) in
 * its own file under `public/ads/<name>.html`, and this component mounts it
 * as the iframe's `srcdoc` (read from that file at build time).
 *
 * 2026-11-01 changes (user decision, same as wowforever and the rest of the
 * fleet; docs/ads.md 「广告位怎么挂」):
 *  - No consent gate. The cookie banner only gates GA / AdSense. Waiting for
 *    "Accept" meant most visitors never loaded a single Adsterra unit (on
 *    wowforever: $0.01 of ad revenue for all of October). The privacy page
 *    says Adsterra banners don't depend on the banner choice.
 *  - srcdoc instead of src="/ads/<name>.html" and NO `allow-same-origin`.
 *    The old same-origin file + allow-same-origin let the creative's script
 *    reach this page; a srcdoc frame without that flag is an opaque origin,
 *    and creatives still render (fleet-wide, all Next sites run this way).
 *    It also stops Cloudflare injecting its analytics beacon into the ad
 *    frame (that beacon failed CORS in an opaque frame, and before that
 *    counted every ad frame as a page view).
 *  - Loads only when visible. srcdoc ignores loading="lazy", so a tiny inline
 *    script fills it from an IntersectionObserver once the slot is within
 *    600px of the viewport. A display:none slot (hideOnMobile on a phone, the
 *    hidden MobileAnchorAd bar, a dismissed anchor) never intersects, so it
 *    never loads: no impressions for ads nobody can see.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_<NAME> (name upper-cased, hyphens become
 * underscores — `sidebar-300x250` → `PUBLIC_ADSTERRA_SLOT_SIDEBAR_300X250`).
 * Empty = nothing rendered, the same env contract as the AdSense slots. The
 * html file must exist in `public/ads/`; a missing file renders nothing
 * (and warns at build time) instead of an empty box.
 */
import { existsSync, readFileSync } from 'node:fs';

interface Props {
  /** Slot name = html filename stem under public/ads/ (e.g. `sidebar-300x250`). */
  name: string;
  /** Creative width in px — keep in sync with the unit's Adsterra size. */
  width: number;
  /** Creative height in px — keep in sync with the unit's Adsterra size. */
  height: number;
  /** Set to `false` to hide the "Advertisement" label (labels default on). */
  label?: boolean;
  /**
   * Hide below md (fixed-size creatives clip inside a narrower iframe —
   * a 728 creative in a ~375px viewport shows ~47% and an inner scrollbar).
   * Pair a hideOnMobile banner with the responsive native-banner, which
   * fills any width. Same pattern as StickyBanner's `hidden md:block`.
   */
  hideOnMobile?: boolean;
}

import { currentSharedStrings } from '~/lib/shared-ui';

const { name, width, height, label = true, hideOnMobile = false } = Astro.props;
const envKey = `PUBLIC_ADSTERRA_SLOT_${name.replace(/-/g, '_').toUpperCase()}`;
// Builds run from the repo root (local and Cloudflare / GitHub Actions alike).
const file = `${process.cwd()}/public/ads/${name}.html`;
const hasFile = existsSync(file);
if (import.meta.env[envKey] && !hasFile) {
  console.warn(`[AdsterraSlot] ${envKey} is set but public/ads/${name}.html is missing — slot not rendered`);
}
const show = !!import.meta.env[envKey] && hasFile;
const srcdoc = show ? readFileSync(file, 'utf8') : '';
const sharedStrings = currentSharedStrings(Astro.currentLocale);
const adLabel = sharedStrings.adLabel ?? 'Advertisement';
---
{
  show && (
    <>
      <div
        class:list={[
          'my-8 flex-col items-center justify-center',
          hideOnMobile ? 'hidden md:flex' : 'flex',
        ]}
      >
        {label && (
          <span class="mb-1 text-[10px] text-muted-foreground">{adLabel}</span>
        )}
        <iframe
          data-ad-srcdoc={srcdoc}
          style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
          scrolling="no"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms"
          title={adLabel}
        />
      </div>
      <script is:inline>
        /* ES2018 only (no optional chaining / nullish coalescing / optional
           catch binding) — runs untranspiled in the HTML, old webviews parse
           it. Fills srcdoc once the slot is visible and within 600px of the
           viewport; display:none slots never intersect, so they never load.
           Idempotent: every slot ships one copy, each only touches frames
           still carrying data-ad-srcdoc. */
        (function () {
          var fill = function (frame) {
            var html = frame.getAttribute('data-ad-srcdoc');
            if (!html) return;
            frame.removeAttribute('data-ad-srcdoc');
            frame.srcdoc = html;
          };
          var run = function () {
            var frames = document.querySelectorAll('iframe[data-ad-srcdoc]');
            if (!('IntersectionObserver' in window)) {
              for (var i = 0; i < frames.length; i++) {
                if (frames[i].offsetParent) fill(frames[i]);
              }
              return;
            }
            var io = new IntersectionObserver(
              function (entries) {
                for (var i = 0; i < entries.length; i++) {
                  if (entries[i].isIntersecting) {
                    fill(entries[i].target);
                    io.unobserve(entries[i].target);
                  }
                }
              },
              { rootMargin: '600px 0px' }
            );
            for (var j = 0; j < frames.length; j++) io.observe(frames[j]);
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', run);
          } else {
            run();
          }
        })();
      </script>
    </>
  )
}
