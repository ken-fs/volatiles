{
  "name": "volatiles",
  "version": "0.1.0",
  "type": "module",
  "description": "Volatiles fan wiki (volatiles.wiki) — built from Ship/game-template-anvil.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/transpile-pagefind.mjs && tsx scripts/write-indexnow-key.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-sitemap": "tsx scripts/check-sitemap.ts",
    "check-config": "tsx scripts/check-config.ts",
    "new-post": "tsx scripts/new-post.ts",
    "bulk-new-posts": "tsx scripts/bulk-new-posts.ts",
    "sync-codes": "tsx scripts/sync-codes.ts",
    "gen-covers": "tsx scripts/gen-covers.ts",
    "gen-assets": "tsx scripts/gen-assets.ts",
    "submit-indexnow": "tsx scripts/submit-indexnow.ts",
    "template-audit": "tsx scripts/template-audit.ts",
    "new-locale": "tsx scripts/new-locale.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-content": "tsx scripts/check-content.ts",
    "refresh-audit": "tsx scripts/refresh-audit.ts",
    "sync-theme": "node scripts/sync-theme.mjs",
    "game-watch": "node scripts/game-watch.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/tailwind": "^5.1.4",
    "@iconify-json/lucide": "^1.2.123",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.29",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "satori": "^0.33.3",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "private": true,
  "license": "MIT"
}
